{
  "name": "@lrclib-api/repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "turbo dev",
    "format": "turbo format",
    "lint": "turbo lint",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "release": "turbo run build lint test && changeset version && changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.27.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.19.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}
