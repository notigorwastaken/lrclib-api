{
  "name": "lrclib-api",
  "version": "2.2.0",
  "description": "Type-safe, dependency-light client for the LRCLIB lyrics API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "docs": "typedoc --out ../../docs --plugin typedoc-github-theme --cname lrclib.js.org",
    "format": "prettier --write .",
    "lint": "eslint . && prettier . --check",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "music",
    "lyrics",
    "api",
    "lrc",
    "lrclib",
    "typescript"
  ],
  "homepage": "https://lrclib.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notigorwastaken/lrclib-api.git",
    "directory": "packages/lrclib-api"
  },
  "bugs": {
    "url": "https://github.com/notigorwastaken/lrclib-api/issues"
  },
  "author": "Igor Figueiredo",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
