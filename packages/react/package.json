{
  "name": "@lrclib-api/react",
  "version": "0.0.1",
  "description": "React provider and hooks for lrclib-api",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "lrclib-api": "^2.0.4",
    "react": ">=17 <20"
  },
  "keywords": [
    "lyrics",
    "lrclib",
    "react",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notigorwastaken/lrclib-api.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/notigorwastaken/lrclib-api/issues"
  },
  "author": "Igor Figueiredo",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lrclib-api": "^2.0.4",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
